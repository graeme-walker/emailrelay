#
# make2cmake
#
# Parses the autoconf/automake artifacts throughout the cwd source
# tree and creates a set of 'cmake' files alongside the source.
#
# Usage: make2cmake [<options>]
#          --no-mbedtls       without mbedtls (ignored on unix: use ./configure --without-mbedtls)
#          --openssl          with openssl/libressl (ignored on unix)
#          --no-gui           without qt and no gui (ignored on unix)
#          --static-gui       gui statically linked to qt
#          --src-dir          base of the source code including Makefile.am files
#          --out-dir=<dir>    base directory for new cmake files (then also "cmake -DREAL_SOURCE_DIR=.../")
#          --qt-find-package  use cmake's find_package() for Qt
#          --no-help          no helpful message about building
#          --for-windows      generate for windows
#          --for-unix         generate for unix
#          --debug-dump       dump BuildInfo and exit
#
# Also used as a perl module by "winbuild.pl" (see also "BuildInfo.pm").
#
# Synopsis:
#  require "make2cmake" ;
#  $make2cmake::cfg_static_gui = 0 ;
#  $make2cmake::cfg_qt_find_package = 0 ;
#  make2cmake::create_cmake_file( $buildinfo , "build-dir" ) ;
#
# On Windows by default the build will use "/MT" (static linkage) for
# the main targets but "/MD" for the GUI. Dynamic linking of the GUI
# allows linking against the binary Qt download, but it is no good
# for distribution. Use "--static-gui" when the Qt libraries have
# been built for static linkage.
#
# On Unix the 3rd-party packages (mbedtls, openssl and qt) should
# be installed in the usual places so that "-l<libname>" works and
# "moc" is on the path. Pass CXXFLAGS and LDFLAGS to the configure
# script if they are somewhere non-standard. These flags and the
# "--with" and "--enable" options are read out of the "config.status"
# file and end up in the generated cmake files.
#
# On Windows cmake must be told explicitly what 3rd-party libraries
# to use and where to find them. The cmake "find_package()" mechanism
# is not normally used because it is an unnecessary layer of obfuscation.
#
# The generated cmake files might require one or more of the following
# values to be passed on the cmake command-line (using "-D"):
#    MBEDTLS_INC          mbedtls headers directory
#    MBEDTLS_RLIB         mbedtls release libraries directory
#    MBEDTLS_DLIB         mbedtls debug libraries directory
#    OPENSSL_INC          mbedtls headers directory
#    OPENSSL_RLIB         openssl debug libraries directory
#    OPENSSL_DLIB         openssl debug libraries directory
#    QT_MOC               full path of Qt moc tool
#    QT_VERSION           5 or 6
#    QT_LIB               Qt libraries directory (unless using --qt-find-package)
#    QT_INC               Qt headers directory (unless using --qt-find-package)
#    CMAKE_PREFIX_PATH    for find_package() to find eg. "Qt6GuiConfig.cmake"
#
# Generated files can be kept out of the source tree can by specifying
# an "--out-dir". The out-dir directory is used as a base for the cmake
# files generated by this script and therefore also for the files generated
# by running cmake. Source file paths are modified by "list(TRANSFORM)"
# directives to point into the read-only source tree.
#
# When running cmake use CMAKE_BUILD_TYPE for debug/release selection
# iff using a single-config generator (eg. nmake). Otherwise pass
# the debug/release selection to the relevant build tool.
#
# Unix, cmake and make:
#   $ ./configure --with-whatever CXXFLAGS="-I/tmp" LDFLAGS="-L/tmp"
#   $ libexec/make2cmake
#   $ mkdir build
#   $ cmake -B build -S .
#   $ cmake --build build (or)
#   $ make -C build VERBOSE=1 -j 12
#
# Windows, cmake and visual studio:
#   $ perl libexec/make2cmake
#   $ mkdir build
#   $ cd build
#   $ cmake
#      -B . -S ..
#      -G "Visual Studio ..." -A "x64" (or "win32")
#      -DQT_LIB=c:\qt5\lib (binary distribution, so must build gui with /MD)
#      -DQT_INC=c:\qt5\include
#      -DQT_VERSION=5
#      -DQT_MOC=c:\qt5\bin\moc.exe
#      -DMBEDTLS_INC=c:\mbedtls\include
#      -DMBEDTLS_RLIB=c:\mbedtls-x64\x64\library\release (with /MT, see mbedtlsbuild.pl)
#      -DMBEDTLS_DLIB=c:\mbedtls-x64\x64\library\debug
#   $ cmake --build . --config release --verbose (or)
#   $ msbuild /p:Configuration=Release emailrelay.sln
#
# MacOS, cmake with find_package() for Qt:
#   $ ./configure --enable-mac ...etc
#   $ libexec/make2cmake --qt-find-package
#   $ cmake -S . -B build
#       -DQT_VERSION=6
#       -DCMAKE_PREFIX_PATH=$HOME/Qt/6.x.x/macos/lib/cmake
#       -DQT_MOC=$HOME/Qt/6.x.x/macos/libexec/moc
#   $ cmake --build build
#

use strict ;
use IO::File ;
use Getopt::Long ;
use File::Basename ;
BEGIN { unshift @INC , dirname($0) }
use BuildInfo ;

package make2cmake ;

our $cfg_static_gui = 0 ;
our $cfg_qt_find_package = 0 ;

sub create_cmake_file
{
	# Creates a cmake file from a BuildInfo-enhanced makefile structure.
	my ( $m , $out_base_dir ) = @_ ;
	$out_base_dir ||= "." ;

	my $relative_path = $m->{e_cmake_out} ; # eg. "src/foo/CMakeLists.txt"
	my $out_path = join( "/" , $out_base_dir , $relative_path ) ;
	mkdir( File::Basename::dirname($out_path) ) ;

	my $fh = new IO::File( $out_path , "w" ) or die ;
	print $fh "# $$m{e_cmake_out} -- generated by $0\n\n" ;
	if( $m->{e_is_top_dir} )
	{
		print $fh "cmake_minimum_required(VERSION 3.17)\n" ;
		print $fh "project($$m{e_project})\n" ;
		my $qt_moc = "/QT_MOC_NOT_SET" ;
		if( $cfg_qt_find_package )
		{
			print $fh "if(QT_VERSION EQUAL 5)\n" ;
			print $fh "find_package( Qt5Gui REQUIRED )\n" ;
			print $fh "find_package( Qt5Widgets REQUIRED )\n" ;
			print $fh "find_package( Qt5Core REQUIRED )\n" ;
			print $fh "set(CMAKE_AUTOMOC on)\n" ;
			print $fh "else()\n" ;
			print $fh "find_package( Qt6 REQUIRED COMPONENTS Core Widgets )\n" ;
			#print $fh "set(QT_MOC \"\${Qt6_BIN_DIR}/moc\")\n" ;
			print $fh "set(CMAKE_AUTOMOC on)\n" ;
			print $fh "endif()\n" ;
			print $fh "\n" ;
		}
		print $fh "set(CMAKE_EXE_LINKER_FLAGS \"\${CMAKE_EXE_LINKER_FLAGS} /MANIFEST:EMBED\")\n" ;
		print $fh "set(CMAKE_MC_COMPILER mc CACHE FILEPATH \"Windows message compiler\")\n" if $m->{e_is_windows} ;
		print $fh "set(QT_LIB /QT_LIB_NOT_SET CACHE PATH \"Direcrory containing Qt libraries\")\n" ;
		print $fh "set(QT_INC /QT_INC_NOT_SET CACHE PATH \"Directory containing Qt headers\")\n" ;
		print $fh "set(QT_MOC /QT_MOC_NOT_SET CACHE FILEPATH \"Qt moc tool\")\n" if !$cfg_qt_find_package ;
		print $fh "set(QT_VERSION $$m{e_qt_version} CACHE STRING \"Version part of Qt library names\")\n" ;
		print $fh "set(MBEDTLS_INC MBEDTLS_INC_NOT_SET CACHE PATH \"Directory containing MbedTLS headers\")\n" ;
		print $fh "set(MBEDTLS_RLIB MBEDTLS_RLIB_NOT_SET CACHE PATH \"Directory containing MbedTLS release-build libraries\")\n" ;
		print $fh "set(MBEDTLS_DLIB MBEDTLS_DLIB_NOT_SET CACHE PATH \"Directory containing MbedTLS debug-build libraries\")\n" ;
		print $fh "set(OPENSSL_INC OPENSSL_INC_NOT_SET CACHE PATH \"Directory containing OpenSSL headers\")\n" ;
		print $fh "set(OPENSSL_RLIB OPENSSL_RLIB_NOT_SET CACHE PATH \"Directory containing OpenSSL release-build libraries\")\n" ;
		print $fh "set(OPENSSL_DLIB OPENSSL_DLIB_NOT_SET CACHE PATH \"Directory containing OpenSSL debug-build libraries\")\n" ;
		print $fh "\n" ;
	}

	# static linkage on windows, except (by default) the gui
	my $msvc_static = $m->{e_is_windows} ? ( !$m->{e_is_gui_dir} || $cfg_static_gui ) : 0 ;
	my $msvc_static_property = $msvc_static ? 'MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>"' : "" ;

	# old-school way of choosing static linking
	if( 0 )
	{
		if( $msvc_static && (scalar(@{$m->{e_programs}})+scalar(@{$m->{e_libraries}})) )
		{
			print $fh 'set(CompilerFlags' , "\n" ;
			print $fh '    CMAKE_CXX_FLAGS' , "\n" ;
			print $fh '    CMAKE_CXX_FLAGS_DEBUG' , "\n" ;
			print $fh '    CMAKE_CXX_FLAGS_RELEASE' , "\n" ;
			print $fh '    CMAKE_C_FLAGS' , "\n" ;
			print $fh '    CMAKE_C_FLAGS_DEBUG' , "\n" ;
			print $fh '    CMAKE_C_FLAGS_RELEASE' , "\n" ;
			print $fh ')' , "\n" ;
			print $fh 'foreach(CompilerFlag ${CompilerFlags})' , "\n" ;
			print $fh '    string(REPLACE "/MD" "/MT" ${CompilerFlag} "${${CompilerFlag}}")' , "\n" ;
			print $fh 'endforeach()' , "\n" ;
			print $fh "\n" ;
		}
	}

	for my $subdir ( @{$m->{e_subdirs}} )
	{
		print $fh "add_subdirectory($subdir)\n" ;
		print $fh "\n" ;
	}

	if( scalar(@{$m->{e_programs}}) && $m->{e_with_qt} )
	{
		if( $cfg_qt_find_package )
		{
			print $fh "if(QT_VERSION EQUAL 5)\n" ;
			print $fh "set(qt_libs Qt5::Gui Qt5::Widgets Qt5::Core)\n" ;
			print $fh "else()\n" ;
			print $fh "set(qt_libs Qt6::Widgets Qt6::Core)\n" ;
			print $fh "endif()\n" ;
			print $fh "set(qt_static_libs )\n" ;
			print $fh "set(qt_static_syslibs )\n" ;
		}
		elsif( $m->{e_is_windows} )
		{
			print $fh "set(qt_moc moc)\n" ;
			print $fh "if(QT_VERSION EQUAL 5)\n" ;
			print $fh "set(qt_libs \n" ;
			map { print $fh "    debug \${QT_LIB}/$_.lib\n" } @{$m->{e_qt5_libnames_debug}} ;
			map { print $fh "    optimized \${QT_LIB}/$_.lib\n" } @{$m->{e_qt5_libnames_release}} ;
			print $fh ")\n" ;
			if( $cfg_static_gui )
			{
				print $fh "set(qt_static_libs \n" ;
				map { print $fh "    debug \${QT_LIB}/$_.lib\n" } @{$m->{e_qt5_static_libnames_debug}} ;
				map { print $fh "    optimized \${QT_LIB}/$_.lib\n" } @{$m->{e_qt5_static_libnames_release}} ;
				print $fh ")\n" ;
				print $fh "set(qt_static_syslibs ",_wrap(@{$m->{e_qt5_static_sys_libnames}}),"\n" ;
				print $fh ")\n" ;
			}
			print $fh "else()\n" ;
			print $fh "set(qt_libs \n" ;
			map { print $fh "    debug \${QT_LIB}/$_.lib\n" } @{$m->{e_qt6_libnames_debug}} ;
			map { print $fh "    optimized \${QT_LIB}/$_.lib\n" } @{$m->{e_qt6_libnames_release}} ;
			print $fh ")\n" ;
			if( $cfg_static_gui )
			{
				print $fh "set(qt_static_libs \n" ;
				map { print $fh "    debug \${QT_LIB}/$_.lib\n" } @{$m->{e_qt6_static_libnames_debug}} ;
				map { print $fh "    optimized \${QT_LIB}/$_.lib\n" } @{$m->{e_qt6_static_libnames_release}} ;
				print $fh ")\n" ;
				print $fh "set(qt_static_syslibs ",_wrap(@{$m->{e_qt6_static_sys_libnames}}),"\n" ;
				print $fh ")\n" ;
			}
			print $fh "endif()\n" ;
		}
		else
		{
			print $fh "if(QT_VERSION EQUAL 5)\n" ;
			print $fh "if(QT_MOC STREQUAL \"/QT_MOC_NOT_SET\")\n" ;
			print $fh "set(QT_MOC /usr/lib/qt5/bin/moc)\n" ;
			print $fh "endif()\n" ;
			print $fh "set(qt_libs \n" ;
			map { print $fh "    debug -l$_\n" } grep {$_!~m/qtmain/} @{$m->{e_qt5_libnames_debug}} ;
			map { print $fh "    optimized -l$_\n" } grep {$_!~m/qtmain/} @{$m->{e_qt5_libnames_release}} ;
			print $fh ")\n" ;
			print $fh "else()\n" ;
			print $fh "if(QT_MOC STREQUAL \"/QT_MOC_NOT_SET\")\n" ;
			print $fh "set(QT_MOC /usr/lib/qt6/libexec/moc)\n" ;
			print $fh "endif()\n" ;
			print $fh "set(qt_libs \n" ;
			map { print $fh "    debug -l$_\n" } grep {$_!~m/qtmain/} @{$m->{e_qt6_libnames_debug}} ;
			map { print $fh "    optimized -l$_\n" } grep {$_!~m/qtmain/} @{$m->{e_qt6_libnames_release}} ;
			print $fh ")\n" ;
			print $fh "endif()\n" ;
			print $fh "set(qt_static_libs )\n" ;
			print $fh "set(qt_static_syslibs )\n" ;
		}
		print $fh "\n" ;
	}

	if( scalar(@{$m->{e_programs}})+scalar(@{$m->{e_libraries}}) )
	{
		# make REAL_SOURCE_DIR default to CMAKE_SOURCE_DIR --
		# see _real_source_dir()
		print $fh "if(NOT DEFINED REAL_SOURCE_DIR)\n" ;
		print $fh "    set(REAL_SOURCE_DIR \${CMAKE_SOURCE_DIR})\n" ;
		print $fh "endif()\n" ;
		print $fh "\n" ;
	}

	for my $library ( @{$m->{e_libraries}} )
	{
		my $e = $m->{e_library}->{$library} ;
		my $c = scalar(@{$e->{sources}}) == 0 ? "#" : "" ;
		my @our_includes = @{$e->{our_includes}} ;
		my @more_includes = @{$e->{more_includes}} ;
		push @more_includes , '"${MBEDTLS_INC}"' if $e->{need_mbedtls_inc} ;
		push @more_includes , '"${OPENSSL_INC}"' if $e->{need_openssl_inc} ;
		push @more_includes , '"${QT_INC}"' if $m->{e_need_qt_inc} ;
		my @definitions = @{$e->{definitions}} ;
		push @definitions , "G_QT_STATIC" if( $m->{e_is_gui_dir} && $cfg_static_gui ) ;
		print $fh "${c}set(sources ",_wrap({sol=>$c},@{$e->{sources}}),")\n" ;
		print $fh "${c}set(includes ",_wrap({sol=>$c},@our_includes),")\n" ;
		print $fh "${c}list(TRANSFORM sources PREPEND "._real_source_dir($m->{e_rdir}).")\n" ;
		print $fh "${c}list(TRANSFORM includes PREPEND "._real_source_dir($m->{e_rdir}).")\n" ;
		print $fh "${c}add_library($$e{libname} STATIC \${sources})\n" ;
		print $fh "${c}target_compile_options($$e{libname} PRIVATE $$e{compile_options})\n" ;
		print $fh "${c}target_include_directories($$e{libname} PRIVATE \${includes} ",join(" ",@more_includes),")\n" ;
		print $fh "${c}target_compile_definitions($$e{libname} PRIVATE ",join(" ",@definitions),")\n" ;
		print $fh "${c}set_property(TARGET $$e{libname} PROPERTY $msvc_static_property)\n" if $msvc_static ;
		if( $cfg_qt_find_package && $m->{e_is_gui_main_dir} )
		{
			print $fh "target_link_libraries($$e{libname} PUBLIC \${qt_libs})\n" ; # sic -- sets qt include path
		}
		print $fh "\n" ;
	}

	for my $progname ( @{$m->{e_programs}} )
	{
		my $e = $m->{e_program}->{$progname} ;
		my $win32 = ( $e->{subsystem} =~ m/windows/i ) ? "WIN32" : "" ;
		my @resources = grep {m/./} ( $e->{mcfile} , $e->{rcfile} , $e->{manifest} ) ;
		my @link_options = @{$e->{link_options}} ;
		push @link_options , $e->{uac_option} if $e->{uac_option} ;
		push @link_options , $e->{commoncontrols_option} if $e->{commoncontrols_option} ;
		my @our_includes = @{$e->{our_includes}} ;
		my @more_includes = @{$e->{more_includes}} ;
		push @more_includes , '"${MBEDTLS_INC}"' if $e->{need_mbedtls_inc} ;
		push @more_includes , '"${OPENSSL_INC}"' if $e->{need_openssl_inc} ;
		push @more_includes , '"${QT_INC}"' if $m->{e_need_qt_inc} ;
		push @more_includes , '"${CMAKE_CURRENT_BINARY_DIR}"' if $m->{need_qt_inc} ; # if #include-ing moc_*.cpp
		my @definitions = @{$e->{definitions}} ;
		push @definitions , "G_NO_MOC_INCLUDE" if( @{$e->{moc_out}} && !$cfg_qt_find_package ) ;
		push @definitions , "G_QT_STATIC" if( $e->{need_qt_libs} && $cfg_static_gui ) ;
		my @all_libs = @{$e->{our_libnames}} ;
		if( $m->{e_is_windows} )
		{
			push @all_libs , map { 'optimized "${MBEDTLS_RLIB}/'.$_.'.lib"' } @{$m->{e_mbedtls_libnames}} if $e->{need_mbedtls_libs} ;
			push @all_libs , map { 'debug "${MBEDTLS_DLIB}/'.$_.'.lib"' } @{$m->{e_mbedtls_libnames}} if $e->{need_mbedtls_libs} ;
			push @all_libs , map { 'optimized "${OPENSSL_RLIB}/'.$_.'.lib"' } @{$m->{e_openssl_libnames}} if $e->{need_openssl_libs} ;
			push @all_libs , map { 'debug "${OPENSSL_DLIB}/'.$_.'.lib"' } @{$m->{e_openssl_libnames}} if $e->{need_openssl_libs} ;
			if( $e->{need_qt_libs} )
			{
				push @all_libs , '${qt_libs}' ;
				if( $cfg_static_gui )
				{
					push @all_libs , '${qt_static_libs}' if $cfg_static_gui ;
					push @all_libs , '${qt_static_syslibs}' if $cfg_static_gui ;
				}
			}
			push @all_libs , @{$e->{sys_libnames}} ; # eg. "comctl32"
		}
		else
		{
			push @all_libs , map { "-l$_" } @{$m->{e_mbedtls_libnames}} if $e->{need_mbedtls_libs} ;
			push @all_libs , map { "-l$_" } @{$m->{e_openssl_libnames}} if $e->{need_openssl_libs} ;
			push @all_libs , '${qt_libs}' if $e->{need_qt_libs} ;
			push @all_libs , map { "-l$_" } @{$e->{sys_libnames}} ; # eg. "-lpam"
		}

		print $fh "set(sources ",_wrap(@{$e->{sources}},@resources),")\n" ;
		print $fh "set(includes ",_wrap(@our_includes),")\n" ;
		print $fh "list(TRANSFORM sources PREPEND "._real_source_dir($m->{e_rdir}).")\n" ;
		print $fh "list(TRANSFORM includes PREPEND "._real_source_dir($m->{e_rdir}).")\n" ;
		if( $cfg_qt_find_package )
		{
			print $fh "add_executable($$e{progname} $win32 \${sources})\n" ;
		}
		else
		{
			print $fh "add_executable($$e{progname} " ,
				join( " " , $win32 , "\${sources}" , _add_prefix('${CMAKE_CURRENT_BINARY_DIR}/',@{$e->{moc_out}}) ) ,
				")\n" ;
		}
		print $fh "target_link_options($$e{progname} PRIVATE ",join(" ",@link_options),")\n" ;
		print $fh "target_include_directories($$e{progname} PRIVATE \${includes} ",join(" ",@more_includes),")\n" ;
		print $fh "target_compile_definitions($$e{progname} PRIVATE ",join(" ",@definitions),")\n" ;
		print $fh "target_compile_options($$e{progname} PRIVATE $$e{compile_options})\n" ;
		print $fh "target_link_libraries($$e{progname} PRIVATE ",_wrap(@all_libs),")\n" ;
		print $fh "set_property(TARGET $$e{progname} PROPERTY $msvc_static_property)\n" if $msvc_static ;

		if( !$cfg_qt_find_package )
		{
			# explicit use of moc since AUTOMOC relies on find_package()
			for my $i ( 0 .. scalar(@{$e->{moc_in}})-1 )
			{
				my $moc_in = @{$e->{moc_in}}[$i] ;
				my $moc_out = @{$e->{moc_out}}[$i] ;
				print $fh "\n" ;
				print $fh "set(moc_in $moc_in)\n" ;
				print $fh "list(TRANSFORM moc_in PREPEND "._real_source_dir($m->{e_rdir}).")\n" ;
				print $fh "add_custom_command(OUTPUT \${CMAKE_CURRENT_BINARY_DIR}/$moc_out DEPENDS \${moc_in}\n" ;
				print $fh "    COMMAND \"\${QT_MOC}\" -o \"\${CMAKE_CURRENT_BINARY_DIR}/$moc_out\" \"\${moc_in}\"\n" ;
				print $fh "    VERBATIM)\n" ;
			}
		}

		if( $e->{mcfile} )
		{
			print $fh "add_dependencies($$e{progname} msg00001bin)\n" ;
			print $fh "\n" ;
			print $fh "set(mcfile_in $$e{mcfile})\n" ;
			print $fh "list(TRANSFORM mcfile_in PREPEND "._real_source_dir($m->{e_rdir}).")\n" ;
			print $fh "add_custom_command(OUTPUT $$e{binfile} DEPENDS \${mcfile_in} \n" ;
			print $fh "    COMMAND \"\${CMAKE_MC_COMPILER}\" \"\${mcfile_in}\"\n" ;
			print $fh "    VERBATIM)\n" ;
			print $fh "add_custom_target(msg00001bin DEPENDS $$e{binfile})\n" ;
		}
		print $fh "\n" ;
	}
	$fh->close() or die ;
}

sub _real_source_dir
{
	my ( $rdir ) = @_ ;
	return "\${REAL_SOURCE_DIR}/$rdir/" ;
}

sub _add_prefix
{
	my ( $prefix , @list ) = @_ ;
	my @result = () ;
	map { push @result , "${prefix}$_" } @list ;
	return @result ;
}

sub _wrap
{
	my ( @words ) = @_ ;

	return "" if( scalar(@words) == 0 ) ;

	my $sol = "" ;
	my $opt = () ;
	if( ref($words[0]) )
	{
		$opt = shift @words ;
		$sol = $opt->{sol} ;
	}

	my $width = 70 ;
	my $indent = ' ' x 4 ;
	my $result = "" ;
	my $over = 0 ;
	my $w = 0 ;
	for my $s ( @words )
	{
		if( ($w+length($s)) > $width )
		{
			$result .= "\n$sol$indent" ;
			$over = 1 ;
			$w = 0 ;
		}
		else
		{
			$result .= " " if( length($result) ) ;
		}
		$result .= $s ;
		$w += (length($s)+1) ;
	}
	if( $over )
	{
		return "\n$sol$indent$result" ;
	}
	else
	{
		return $result ;
	}
}

sub _libfile
{
	my ( $m , $libname ) = @_ ;
	my $filename = $m->{e_is_windows} ? "$libname.lib" : "lib$libname.a" ;
	return $filename ;
}

# ==

package main ;

if( basename($0) eq "make2cmake" )
{
	my %opt = () ;
	if( !GetOptions( \%opt , "help|h" , "no-mbedtls" , "openssl" , "no-gui" ,
		"static-gui|s" , "src-dir=s" , "out-dir=s" ,
		"verbose|v" , "debug-dump" , "debug-dump-all" ,
		"for-windows|w" , "for-unix|u" ,
		"qt-find-package" , "no-help" ) || $opt{help} )
	{
		my $error = $opt{help} ? "" : "error: " ;
		print "${error}usage: make2cmake [<options>]\n" ;
		print "          --no-mbedtls     without mbedtls (windows only)\n" ;
		print "          --openssl        with openssl (windows only)\n" ;
		print "          --no-gui         without qt and no gui (windows only)\n" ;
		print "          --static-gui     gui statically linked to qt\n" ;
		print "          --src-dir=<dir>  source code base directory\n" ;
		print "          --out-dir=<dir>  base directory for new cmake files\n" ;
		print "          --no-help\n" ;
		print "          --debug-dump\n" ;
		print "          --debug-dump-all\n" ;
		print "          --qt-find-package\n" ;
		print "          --for-windows\n" ;
		print "          --for-unix\n" ;
		exit( $error ? 1 : 0 ) ;
	}

	my $opt_for_windows = undef ;
	$opt_for_windows = 1 if $opt{'for-windows'} ;
	$opt_for_windows = 0 if $opt{'for-unix'} ;
	$opt_for_windows = 1 if( !defined($opt_for_windows) && ( $^O =~ m/win/i ) ) ;
	$opt_for_windows = 0 if !defined($opt_for_windows) ;

	$make2cmake::cfg_static_gui = $opt{'static-gui'} ; # see also BuildInfo::qt_is_static()
	$make2cmake::cfg_qt_find_package = $opt{'qt-find-package'} ;
	my %makefiles_opt = (
		windows => $opt_for_windows ,
		windows_mbedtls => !$opt{'no-mbedtls'} ,
		windows_openssl => $opt{openssl} ,
		windows_gui => !$opt{'no-gui'} ,
		verbose => $opt{verbose} , # AutoMakeParser::readall()
	) ;

	my $in_base_dir = $opt{'src-dir'} || "." ; # base of source including Makefile.am files
	my $out_base_dir = $opt{'out-dir'} || "." ; # base for creating cmake files

	my @m = BuildInfo::read_makefiles( $in_base_dir , "make2cmake: " , \%makefiles_opt ) ;
	if( $opt{'debug-dump'} ) { BuildInfo::dump( @m ) ; exit(0) }
	if( $opt{'debug-dump-all'} ) { BuildInfo::dumpall( @m ) ; exit(0) }
	for my $m ( @m )
	{
		print "make2cmake: cmake-file=[$$m{e_cmake_out}]\n" ;
		make2cmake::create_cmake_file( $m , $out_base_dir ) ;
	}

	if( ! $opt{'no-help'} )
	{
		my $make_program = "" ;
		if( $^O !~ m/win/i )
		{
			chomp( my $gmake = `which gmake` ) ;
			chomp( my $make = `which make` ) ;
			$make_program = $make if( $gmake && $gmake ne "/usr/bin/gmake" ) ;
		}
		print "make2cmake: CMakeLists.txt files created: now use cmake in a build directory, eg:\n" ;
		print "  \$ cmake -S . -B build" ;
		print " -DCMAKE_PREFIX_PATH=.../lib/cmake" if( $cfg_qt_find_package ) ;
		print " -DCMAKE_MAKE_PROGRAM=$make_program" if( $make_program ) ;
		print "\n" ;
		print "  \$ cmake --build build -j\n" ;
	}
}
else
{
	1 ;
}

